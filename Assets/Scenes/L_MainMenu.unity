  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: " - People seem to have gone mad, as if their minds had been taken over by a virus. This virus appears to be spreading rapidly. Everywhere you go, you see people waving their hands, screaming \"67\" like lunatics, and talking about \"Aura Battle,\" \"Aura Farming,\" and getting \"mogged.\" These people must be out of their minds. It\u2019s time to grab your trusty 7-shot revolver, \"Lucky 7,\" and put an end to this madness once and for all."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0ba3a0829d16c1b439ff471d5777f175, type: 2}
